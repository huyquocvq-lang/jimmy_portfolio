# =============================================================================
# Portfolio environment variables (Vite)
# =============================================================================
#
# Vite only exposes vars prefixed with `VITE_` to the client bundle.
# Copy this file to `.env.local` (gitignored) and override per machine, or
# commit a `.env` for project-wide defaults.
#
# Vite inlines values at build time, so any change here requires restarting
# `npm run dev` to take effect.

# -----------------------------------------------------------------------------
# Mobile content trim (≤ VITE_MOBILE_BREAKPOINT_PX wide)
# -----------------------------------------------------------------------------
# Each *_LIMIT is "show the first N tiles" - items beyond that index are
# hidden via display:none on the masonry / grid. Set to 0 to hide a section
# entirely on mobile; set to a large value (e.g. 99) to disable the trim.

# Personal photo masonry. Defaults shipped with 8 photos, trim to 4.
VITE_MOBILE_PERSONAL_LIMIT=4

# Impact Highlights grid. Defaults shipped with 6 highlights, trim to 4.
VITE_MOBILE_IMPACT_LIMIT=4

# Other-projects grid on the homepage (excludes the featured card). Defaults
# shipped with 6 cards, trim to 3. The "View all →" link in the projects
# header still routes to /projects for the full list.
VITE_MOBILE_PROJECTS_LIMIT=3

# Hide the optional Technologies / Outstanding projects meta rows under each
# experience entry. Accepts true|false|1|0|yes|no.
VITE_MOBILE_HIDE_EXPERIENCE_META=true

# Mobile breakpoint in pixels. Anything below applies the trim above.
VITE_MOBILE_BREAKPOINT_PX=768
